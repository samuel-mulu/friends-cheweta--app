<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: brand navy with the app mark, so there is no white
     flash before the animated Flutter splash takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_navy" />
    <item>
        <bitmap android:gravity="center" android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
